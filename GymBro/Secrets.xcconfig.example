// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Same Supabase project as the web app — see ../Gym Bro React/.env.local for
// the values (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
// Host only (no scheme) — xcconfig treats "//" as a comment start even inside
// quotes, so the "https://" prefix lives directly in Info.plist instead.
SUPABASE_HOST = your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
